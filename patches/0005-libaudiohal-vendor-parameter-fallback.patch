 using aidl::android::aidl_utils::statusTFromBinderStatus;
 using aidl::android::hardware::audio::core::VendorParameter;
 using aidl::android::media::audio::IHalAdapterVendorExtension;
 
 namespace android {
 
+// Splits a ";"-separated list into its non-empty items.
+std::vector<std::string> splitSemicolonListForVendorParams(const char* raw) {
+    std::vector<std::string> out;
+    if (raw == nullptr) return out;
+    const std::string all(raw);
+    size_t start = 0;
+    while (start < all.size()) {
+        size_t end = all.find(';', start);
+        if (end == std::string::npos) end = all.size();
+        if (end > start) out.push_back(all.substr(start, end - start));
+        if (end == all.size()) break;
+        start = end + 1;
+    }
+    return out;
+}
+
+// Used when the vendor does not provide an IHalAdapterVendorExtension
+// implementation. The vendor audio HAL expects each vendor parameter as a
+// VendorParameter whose payload is a qti-style VString, so build them here.
+void fillVendorParametersFallback(const AudioParameter& parameters,
+                                 std::vector<VendorParameter>* syncParameters) {
+    const String8 rawKeysAndValues = parameters.toString();
+    for (const auto& pair : splitSemicolonListForVendorParams(rawKeysAndValues.c_str())) {
+        const size_t eq = pair.find('=');
+        if (eq == std::string::npos || eq == 0) continue;
+        ::aidl::qti::audio::core::VString payload;
+        payload.value = pair.substr(eq + 1);
+        VendorParameter parameter;
+        parameter.id = pair.substr(0, eq);
+        parameter.ext.setParcelable(payload);
+        syncParameters->push_back(std::move(parameter));
+    }
+    ALOGW("vendor fallback (ConversionHelper) built %d parameters",
+          static_cast<int>(syncParameters->size()));
+}
+

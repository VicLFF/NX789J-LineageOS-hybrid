+    name: "ims",
+    apk: "prebuilts/ims/system_ext/priv-app/ims/ims.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    privileged: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "QtiTelephony",
+    apk: "prebuilts/ims/system_ext/priv-app/QtiTelephony/QtiTelephony.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    privileged: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "qcrilmsgtunnel",
+    apk: "prebuilts/ims/system_ext/priv-app/qcrilmsgtunnel/qcrilmsgtunnel.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    privileged: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "QtiTelephonyService",
+    apk: "prebuilts/ims/system_ext/app/QtiTelephonyService/QtiTelephonyService.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "ImsRcsService",
+    apk: "prebuilts/ims/system_ext/app/ImsRcsService/ImsRcsService.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "ImsDataChannelService",
+    apk: "prebuilts/ims/system_ext/app/ImsDataChannelService/ImsDataChannelService.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "imssettings",
+    apk: "prebuilts/ims/system_ext/app/imssettings/imssettings.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    dex_preopt: { enabled: false },
+}
+
+android_app_import {
+    name: "uceShimService",
+    apk: "prebuilts/ims/system_ext/app/uceShimService/uceShimService.apk",
+    presigned: true,
+    preprocessed: true,
+    system_ext_specific: true,
+    dex_preopt: { enabled: false },
+}
+
+// --- ZTE 原厂屏下指纹配套应用（自官方 RedMagicOS system 镜像提取） ---
+android_app_import {
+    name: "FingerprintSensorUi_ZTE",
+    apk: "prebuilts/fp/apk/FingerprintSensorUi_ZTE.apk",
+    privileged: true,
+    certificate: "platform",
+    dex_preopt: {
+        enabled: false,
+    },
+}
+
+android_app_import {
+    name: "FingerprintService_ZTE",
+    apk: "prebuilts/fp/apk/FingerprintService_ZTE.apk",
+    privileged: true,
+    certificate: "platform",
+    dex_preopt: {

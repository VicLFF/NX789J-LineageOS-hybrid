diff --git a/audioext/HalAdapterVendorExt.cpp b/audioext/HalAdapterVendorExt.cpp
new file mode 100644
index 0000000..de2f1db
--- /dev/null
+++ b/audioext/HalAdapterVendorExt.cpp
@@ -0,0 +1,158 @@
+/*
+ * IHalAdapterVendorExtension for the QTI Audio Core HAL on this platform.
+ *
+ * The AudioCore framework adapter parses legacy vendor parameter strings with
+ * the help of this service (see ConversionHelperAidl.cpp
+ * fillVendorParameters()).  Without it every vendor parameter is dropped,
+ * which means IModule::setVendorParameters() is never called and the
+ * telephony voice stream is never started => no audio during calls.
+ *
+ * The QTI HAL extracts each payload as
+ *     extractParameter<aidl::qti::audio::core::VString>(p, &value)
+ * i.e. p.ext holds exactly that parcelable.
+ */
+
+#define LOG_TAG "HalAdapterVendorExt"
+
+#include <android/binder_auto_utils.h>
+#include <android/binder_manager.h>
+#include <android/binder_parcelable_utils.h>
+#include <android/binder_process.h>
+#include <android/binder_status.h>
+#include <log/log.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <aidl/android/hardware/audio/core/VendorParameter.h>
+#include <aidl/android/media/audio/BnHalAdapterVendorExtension.h>
+#include <aidl/aidl/qti/audio/core/VString.h>
+
+namespace {
+
+using ::aidl::android::hardware::audio::core::VendorParameter;
+using ::aidl::android::media::audio::BnHalAdapterVendorExtension;
+using ::aidl::android::media::audio::IHalAdapterVendorExtension;
+using ::aidl::aidl::qti::audio::core::VString;
+using ::ndk::ScopedAStatus;
+
+constexpr uint32_t kMaxParameter = 64;
+
+// Splits "a;b;c" into {"a", "b", "c"}.
+std::vector<std::string> splitSemicolon(const std::string& raw) {
+    std::vector<std::string> out;
+    size_t start = 0;
+    while (start <= raw.size() && out.size() < kMaxParameter) {
+        size_t end = raw.find(';', start);
+        if (end == std::string::npos) {
+            end = raw.size();
+        }
+        if (end > start) {
+            out.push_back(raw.substr(start, end - start));
+        }
+        if (end == raw.size()) {
+            break;
+        }
+        start = end + 1;
+    }
+    return out;
+}
+
+class HalAdapterVendorExtension : public BnHalAdapterVendorExtension {
+  public:
+    ScopedAStatus parseVendorParameterIds(ParameterScope /*in_scope*/,
+                                          const std::string& in_rawKeys,
+                                          std::vector<std::string>* _aidl_return) override {
+        if (_aidl_return == nullptr) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        *_aidl_return = splitSemicolon(in_rawKeys);
+        return ScopedAStatus::ok();
+    }
+
+    ScopedAStatus parseVendorParameters(ParameterScope /*in_scope*/,
+                                        const std::string& in_rawKeysAndValues,
+                                        std::vector<VendorParameter>* out_syncParameters,
+                                        std::vector<VendorParameter>* out_asyncParameters) override {
+        if (out_syncParameters == nullptr || out_asyncParameters == nullptr) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        out_syncParameters->clear();
+        out_asyncParameters->clear();
+
+        for (const std::string& pair : splitSemicolon(in_rawKeysAndValues)) {
+            const size_t eq = pair.find('=');
+            const std::string id = (eq == std::string::npos) ? pair : pair.substr(0, eq);
+            const std::string value =
+                    (eq == std::string::npos) ? std::string() : pair.substr(eq + 1);
+            if (id.empty()) {
+                continue;
+            }
+            VString payload;
+            payload.value = value;
+            VendorParameter parameter;
+            parameter.id = id;
+            if (parameter.ext.setParcelable(payload) != 0) {
+                ALOGE("%s: failed to set parcel for %s", __func__, id.c_str());
+                continue;
+            }
+            ALOGV("%s: %s=%s", __func__, id.c_str(), value.c_str());
+            out_syncParameters->push_back(std::move(parameter));
+        }
+        return ScopedAStatus::ok();
+    }
+
+    ScopedAStatus parseBluetoothA2dpReconfigureOffload(
+            const std::string& /*in_rawValue*/,
+            std::vector<VendorParameter>* _aidl_return) override {
+        if (_aidl_return == nullptr) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        _aidl_return->clear();
+        return ScopedAStatus::ok();
+    }
+
+    ScopedAStatus parseBluetoothLeReconfigureOffload(
+            const std::string& /*in_rawValue*/,
+            std::vector<VendorParameter>* _aidl_return) override {
+        if (_aidl_return == nullptr) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        _aidl_return->clear();
+        return ScopedAStatus::ok();
+    }
+
+    ScopedAStatus processVendorParameters(ParameterScope /*in_scope*/,
+                                          const std::vector<VendorParameter>& /*in_parameters*/,
+                                          std::string* _aidl_return) override {
+        if (_aidl_return == nullptr) {
+            return ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+        }
+        _aidl_return->clear();
+        return ScopedAStatus::ok();
+    }
+};
+
+}  // namespace
+
+int main() {
+    ABinderProcess_setThreadPoolMaxThreadCount(2);
+
+    std::shared_ptr<HalAdapterVendorExtension> service =
+            ::ndk::SharedRefBase::make<HalAdapterVendorExtension>();
+    const std::string instance = std::string(IHalAdapterVendorExtension::descriptor) + "/default";
+
+    binder_status_t status =
+            AServiceManager_addService(service->asBinder().get(), instance.c_str());
+    if (status != STATUS_OK) {
+        ALOGE("failed to register %s: %d", instance.c_str(), status);
+        return 1;
+    }
+    ALOGI("registered %s", instance.c_str());
+
+    ABinderProcess_startThreadPool();
+    ABinderProcess_joinThreadPool();
+    return 0;
+}
